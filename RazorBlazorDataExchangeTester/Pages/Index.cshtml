@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject RazorBlazorDataExchange DataExchange
@model RazorBlazorDataExchangeTester.Pages.IndexModel

@{
    ViewData["Title"] = "Home page";
}

<div class="text-center" data-testid="razor-host">
    <form id="antiForgeryForm">
        @Html.AntiForgeryToken()
    </form>

    <h1 class="display-4">Razor &lt;-&gt; Blazor Interop Demo</h1>
    <p>DataExchange Service Instance HashCode in Razor Page: <span data-testid="razor-broker-hash">@DataExchange.GetHashCode()</span></p>
    <p>DataExchange SessionId: <span data-testid="razor-session-id">@Model.SessionId</span></p>

    <div class="counter-container mb-4 card">
        <div class="card-body">
            <h5 class="card-title">Razor host</h5>
            <p class="lead">Counter value in Razor DOM: <span id="counter-value" data-testid="razor-counter-value">@Model.XCounter</span></p>
            <p>Last live DOM update source: <span id="last-update-source" data-testid="last-update-source">Razor initial render</span></p>
            <p class="mb-1">Razor event stream: <span data-testid="razor-event-stream-status">connecting</span></p>
            <p class="mb-1">DOM update transport: <span data-testid="razor-dom-transport">initial render</span></p>
            <p class="mb-1">Blazor JSInterop calls: <span data-testid="js-bridge-calls">0</span></p>
            <div class="small text-muted mb-2">
                Generic C# DOM bindings:
                <input id="dom-counter-input" data-testid="dom-counter-input"
                       aria-label="Counter updated by RazorDomBridge" readonly
                       value="@Model.XCounter" size="4" />
                <label class="ms-2"><input id="dom-counter-odd" data-testid="dom-counter-odd"
                       type="checkbox" disabled checked="@(Model.XCounter % 2 != 0)" /> Counter is odd</label>
                <span id="dom-event-indicator" data-testid="dom-event-indicator" hidden>— DataChanged processed</span>
            </div>
            <div class="form-check d-inline-flex align-items-center gap-2 mb-3">
                <input type="checkbox"
                       class="form-check-input"
                       id="js-dom-bridge-checkbox"
                       data-testid="js-dom-bridge-checkbox"
                       checked="@Model.JsBridgeEnabled"
                       onchange="setJsDomBridgeEnabled(this)" />
                <label class="form-check-label" for="js-dom-bridge-checkbox">
                    Use JavaScript bridge to update the Razor counter from Blazor
                </label>
            </div>
            <hr />
            <p class="mb-1"><strong>Last Razor server-side DataChanged event</strong></p>
            <p class="mb-1">Actor: <span id="razor-observed-change-actor" data-testid="razor-observed-change-actor">@Model.LastObservedChangeActor</span></p>
            <p class="mb-1">Property: <span id="razor-observed-change-property" data-testid="razor-observed-change-property">@Model.LastObservedChangeProperty</span></p>
            <p class="mb-1">Value: <span id="razor-observed-change-value" data-testid="razor-observed-change-value">@Model.LastObservedChangeValue</span></p>
            <p class="mb-1">Version: <span id="razor-observed-change-version" data-testid="razor-observed-change-version">@Model.LastObservedChangeVersion</span></p>
            <button id="increment-btn"
                    data-testid="increment-razor"
                    type="button"
                    class="btn btn-success"
                    onclick="incrementCounter()">
                Increase from Razor
            </button>
        </div>
    </div>

    <div class="row text-start">
        <div class="col-md-6">
            <component type="typeof(BlazorComponents.CounterComponent)"
                       render-mode="Server"
                       param-RazorBlazorDataExchangeSessionId="@(Model.SessionId)"
                       param-ComponentId="@("CounterComponent1")"
                       param-buttonText="@("Increase from Blazor Component 1")"
                       param-counterText="@("Current value in Blazor Component 1:")"
                       param-XCounter="@Model.XCounter"
                       param-JsMessageHandler="@("handleBlazorEvent")"
                       param-EnableJsDomBridge="@(true)" />
        </div>
        <div class="col-md-6">
            <component type="typeof(BlazorComponents.CounterComponent)"
                       render-mode="Server"
                       param-RazorBlazorDataExchangeSessionId="@(Model.SessionId)"
                       param-ComponentId="@("CounterComponent2")"
                       param-buttonText="@("Increase from Blazor Component 2")"
                       param-counterText="@("Current value in Blazor Component 2:")"
                       param-XCounter="@Model.XCounter"
                       param-JsMessageHandler="@("handleBlazorEvent")"
                       param-EnableJsDomBridge="@(Model.EnableCounter2JsDomBridge)" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/razor-dom-bridge.js" asp-append-version="true"></script>
    <script>
        let jsBridgeCalls = 0;

        // Generic library applies DOM commands requested from C# in
        // IndexModel.OnDataChanged(). No Razor-specific DOM dispatch code here.
        // The optional Blazor JSInterop callback below remains independent.
        const razorEventStream = RazorDomBridge.connect('/Index?handler=CounterEvents', {
            onReady: () => {
                document.querySelector('[data-testid="razor-event-stream-status"]').textContent = 'connected';
            },
            onError: () => {
                document.querySelector('[data-testid="razor-event-stream-status"]').textContent = 'reconnecting';
            }
        });

        async function setJsDomBridgeEnabled(checkbox) {
            const requestedValue = checkbox.checked;
            checkbox.disabled = true;
            try {
                const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
                const response = await fetch('/Index?handler=SetJsBridge', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ enabled: requestedValue })
                });

                if (!response.ok)
                    throw new Error('HTTP ' + response.status);

                const result = await response.json();
                checkbox.checked = result.enabled;
            }
            catch (error) {
                checkbox.checked = !requestedValue;
                console.error('Unable to change JS DOM bridge setting.', error);
            }
            finally {
                checkbox.disabled = false;
            }
        }

        // Original Blazor -> Razor JSInterop path remains available as a
        // separate optional mechanism controlled by the existing checkbox.
        function handleBlazorEvent(source, value) {
            jsBridgeCalls++;
            document.querySelector('[data-testid="js-bridge-calls"]').textContent = jsBridgeCalls;
            document.getElementById('counter-value').innerText = value;
            document.getElementById('last-update-source').innerText = source || 'Blazor';
            document.querySelector('[data-testid="razor-dom-transport"]').textContent = 'Blazor JSInterop';
        }

        async function incrementCounter() {
            const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;
            const response = await fetch('/Index?handler=IncrementCounter', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }
            });

            if (!response.ok) {
                console.error('Razor counter update failed.', response.status, response.statusText);
                return;
            }

            const data = await response.json();
            document.getElementById('counter-value').innerText = data.value;
            document.getElementById('last-update-source').innerText = 'Razor:/Index';
            document.querySelector('[data-testid="razor-dom-transport"]').textContent = 'Razor POST fetch';
        }
    </script>
}
