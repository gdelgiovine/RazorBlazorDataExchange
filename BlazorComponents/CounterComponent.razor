@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IDisposable
@inject RazorBlazorDataExchange DataExchange
@inject IJSRuntime JS

<div class="blazor-counter card mb-3"
     data-testid="blazor-counter"
     data-component-id="@ComponentId"
     data-actor-id="@_actorId">
    <div class="card-body">
        <h5 class="card-title">Blazor component @ComponentId</h5>
        <p class="mb-1">DataExchange Service Instance HashCode: <span data-testid="broker-hash">@DataExchange.GetHashCode()</span></p>
        <p class="mb-1">SessionId: <span data-testid="session-id">@RazorBlazorDataExchangeSessionId</span></p>
        <p class="mb-2">ActorId: <span data-testid="actor-id">@_actorId</span></p>
        <p class="lead mb-3">@counterText <span data-testid="counter-value">@XCounter</span></p>
        <button type="button"
                class="btn btn-primary"
                data-testid="increment-blazor"
                @onclick="IncrementCount">
            @buttonText
        </button>
    </div>
</div>

@namespace BlazorComponents

@code {
    private const string CounterProperty = "XCounter";

    [Parameter, EditorRequired]
    public string RazorBlazorDataExchangeSessionId { get; set; } = string.Empty;

    [Parameter]
    public string? ComponentId { get; set; }

    [Parameter]
    public int initialCount { get; set; }

    [Parameter]
    public int XCounter { get; set; }

    [Parameter]
    public string buttonText { get; set; } = "Click me";

    [Parameter]
    public string counterText { get; set; } = "Current count:";

    [Parameter]
    public string JsMessageHandler { get; set; } = "handleBlazorEvent";

    private IDisposable? _subscription;
    private string? _boundSessionId;
    private string _actorId = string.Empty;
    private int _currentCount;

    protected override void OnParametersSet()
    {
        ComponentId ??= Guid.NewGuid().ToString("N");
        var actorId = $"Blazor:{nameof(CounterComponent)}:{ComponentId}";

        if (string.Equals(_boundSessionId, RazorBlazorDataExchangeSessionId, StringComparison.Ordinal) &&
            string.Equals(_actorId, actorId, StringComparison.Ordinal))
        {
            return;
        }

        _subscription?.Dispose();
        _boundSessionId = RazorBlazorDataExchangeSessionId;
        _actorId = actorId;

        if (DataExchange.TryGet<int>(RazorBlazorDataExchangeSessionId, CounterProperty, out var existing))
        {
            _currentCount = existing;
        }
        else
        {
            _currentCount = XCounter != 0 ? XCounter : initialCount;
            DataExchange.StoreValue(
                RazorBlazorDataExchangeSessionId,
                CounterProperty,
                _currentCount,
                _actorId);
        }

        XCounter = _currentCount;

        _subscription = DataExchange.Subscribe<int>(
            RazorBlazorDataExchangeSessionId,
            CounterProperty,
            _actorId,
            OnCounterChangedAsync);
    }

    private async Task IncrementCount()
    {
        var message = await DataExchange.UpdateAsync<int>(
            RazorBlazorDataExchangeSessionId,
            CounterProperty,
            current => current + 1,
            _actorId);

        if (message is not null)
        {
            _currentCount = message.Value;
            XCounter = _currentCount;
        }

        // The broker carries the Blazor -> Razor state transition server-side.
        // The Razor Page instance that rendered this DOM is no longer live, therefore
        // JS interop is the final live UI hop for the already-rendered Razor document.
        await JS.InvokeVoidAsync(JsMessageHandler, _actorId, XCounter);
    }

    private async ValueTask OnCounterChangedAsync(
        ExchangeMessage<int> message,
        CancellationToken cancellationToken)
    {
        await InvokeAsync(() =>
        {
            _currentCount = message.Value;
            XCounter = _currentCount;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _subscription?.Dispose();
        _subscription = null;
    }
}
