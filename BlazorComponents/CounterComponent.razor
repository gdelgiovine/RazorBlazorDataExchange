@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IDisposable
@inject RazorBlazorDataExchange DataExchange
@inject IJSRuntime JS

<p>DataExchange Service Instance HashCode in Blazor Component: @DataExchange.GetHashCode()</p>
<p>DataExchange SessionId in Blazor Component: @RazorBlazorDataExchangeSessionId</p>
<p>DataExchange Blazor Component ComponentId: @ComponentId</p>
<p>@counterText @XCounter</p>
<button class="btn btn-primary" @onclick="IncrementCount">@buttonText</button>

@namespace BlazorComponents

@code {
    private const string CounterProperty = "XCounter";

    [Parameter, EditorRequired]
    public string RazorBlazorDataExchangeSessionId { get; set; } = string.Empty;

    [Parameter]
    public string? ComponentId { get; set; }

    [Parameter]
    public int initialCount { get; set; }

    [Parameter]
    public int XCounter { get; set; }

    [Parameter]
    public string buttonText { get; set; } = "Click me";

    [Parameter]
    public string counterText { get; set; } = "Current count:";

    [Parameter]
    public string JsMessageHandler { get; set; } = "handleBlazorEvent";

    private IDisposable? _subscription;
    private string? _boundSessionId;
    private string _actorId = string.Empty;
    private int _currentCount;

    protected override void OnParametersSet()
    {
        ComponentId ??= Guid.NewGuid().ToString("N");
        var actorId = $"Blazor:{nameof(CounterComponent)}:{ComponentId}";

        if (string.Equals(_boundSessionId, RazorBlazorDataExchangeSessionId, StringComparison.Ordinal) &&
            string.Equals(_actorId, actorId, StringComparison.Ordinal))
        {
            return;
        }

        _subscription?.Dispose();
        _boundSessionId = RazorBlazorDataExchangeSessionId;
        _actorId = actorId;

        if (DataExchange.TryGet<int>(RazorBlazorDataExchangeSessionId, CounterProperty, out var existing))
        {
            _currentCount = existing;
        }
        else
        {
            _currentCount = XCounter != 0 ? XCounter : initialCount;
            DataExchange.StoreValue(
                RazorBlazorDataExchangeSessionId,
                CounterProperty,
                _currentCount,
                _actorId);
        }

        XCounter = _currentCount;

        _subscription = DataExchange.Subscribe<int>(
            RazorBlazorDataExchangeSessionId,
            CounterProperty,
            _actorId,
            OnCounterChangedAsync);
    }

    private async Task IncrementCount()
    {
        var message = await DataExchange.UpdateAsync<int>(
            RazorBlazorDataExchangeSessionId,
            CounterProperty,
            current => current + 1,
            _actorId);

        if (message is not null)
        {
            _currentCount = message.Value;
            XCounter = _currentCount;
        }

        // A Razor Page is not a live server-side UI after the HTTP response has been sent.
        // JS interop is therefore the live Blazor -> already-rendered Razor DOM channel.
        await JS.InvokeVoidAsync(JsMessageHandler, string.Empty, XCounter);
    }

    private async ValueTask OnCounterChangedAsync(
        ExchangeMessage<int> message,
        CancellationToken cancellationToken)
    {
        await InvokeAsync(() =>
        {
            _currentCount = message.Value;
            XCounter = _currentCount;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _subscription?.Dispose();
        _subscription = null;
    }
}
