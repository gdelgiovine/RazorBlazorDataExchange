@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IDisposable
@inject RazorBlazorDataExchange DataExchange
@inject IJSRuntime JS

<div class="blazor-counter card mb-3"
     data-testid="blazor-counter"
     data-component-id="@ComponentId"
     data-instance-id="@_instanceId"
     data-actor-id="@_actorId">
    <div class="card-body">
        <h5 class="card-title">Blazor component @ComponentId</h5>
        <p class="mb-1">DataExchange Service Instance HashCode: <span data-testid="broker-hash">@DataExchange.GetHashCode()</span></p>
        <p class="mb-1">SessionId: <span data-testid="session-id">@RazorBlazorDataExchangeSessionId</span></p>
        <p class="mb-1">Component instance: <span data-testid="instance-id">@_instanceId</span></p>
        <p class="mb-2">ActorId: <span data-testid="actor-id">@_actorId</span></p>
        <p class="lead mb-3">@counterText <span data-testid="counter-value">@XCounter</span></p>
        <button type="button"
                class="btn btn-primary"
                data-testid="increment-blazor"
                @onclick="IncrementCount">
            @buttonText
        </button>
    </div>
</div>

@namespace BlazorComponents

@code {
    private const string CounterProperty = "XCounter";
    private const string JsBridgeProperty = "JsDomBridgeEnabled";

    [Parameter, EditorRequired]
    public string RazorBlazorDataExchangeSessionId { get; set; } = string.Empty;

    /// <summary>
    /// Logical component identifier supplied by the host. It does not identify a concrete
    /// Blazor component instance because the same logical component can exist in multiple circuits.
    /// </summary>
    [Parameter]
    public string? ComponentId { get; set; }

    [Parameter]
    public int initialCount { get; set; }

    [Parameter]
    public int XCounter { get; set; }

    [Parameter]
    public string buttonText { get; set; } = "Click me";

    [Parameter]
    public string counterText { get; set; } = "Current count:";

    [Parameter]
    public string JsMessageHandler { get; set; } = "handleBlazorEvent";

    /// <summary>
    /// Optional browser-DOM bridge. Change-event communication remains active when this is false.
    /// </summary>
    [Parameter]
    public bool EnableJsDomBridge { get; set; } = true;

    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private bool _changeEventSubscribed;
    private string? _boundSessionId;
    private string _actorId = string.Empty;
    private int _currentCount;
    private bool _jsBridgeEnabled;

    protected override void OnParametersSet()
    {
        ComponentId ??= Guid.NewGuid().ToString("N");

        // ComponentId is intentionally only a logical host id. ActorId must identify the
        // concrete component instance, otherwise equal ComponentIds in separate SignalR
        // circuits would incorrectly suppress each other's notifications as self-publishes.
        var actorId = $"Blazor:{nameof(CounterComponent)}:{ComponentId}:{_instanceId}";

        if (string.Equals(_boundSessionId, RazorBlazorDataExchangeSessionId, StringComparison.Ordinal) &&
            string.Equals(_actorId, actorId, StringComparison.Ordinal))
        {
            return;
        }

        _boundSessionId = RazorBlazorDataExchangeSessionId;
        _actorId = actorId;

        if (DataExchange.TryGet<int>(RazorBlazorDataExchangeSessionId, CounterProperty, out var existing))
        {
            _currentCount = existing;
        }
        else
        {
            _currentCount = XCounter != 0 ? XCounter : initialCount;
            DataExchange.StoreValue(
                RazorBlazorDataExchangeSessionId,
                CounterProperty,
                _currentCount,
                _actorId);
        }

        XCounter = _currentCount;

        // EnableJsDomBridge is a per-component host permission (used by the legacy
        // Counter2 test override); the session-wide checkbox is broker state.
        _jsBridgeEnabled = EnableJsDomBridge &&
            (!DataExchange.TryGet<bool>(
                RazorBlazorDataExchangeSessionId,
                JsBridgeProperty,
                out var setting) || setting);

        if (!_changeEventSubscribed)
        {
            DataExchange.DataChanged += OnDataChanged;
            _changeEventSubscribed = true;
        }
    }

    private async Task IncrementCount()
    {
        var message = await DataExchange.UpdateAsync<int>(
            RazorBlazorDataExchangeSessionId,
            CounterProperty,
            current => current + 1,
            _actorId);

        if (message is not null)
        {
            _currentCount = message.Value;
            XCounter = _currentCount;
        }

        // DataChanged is the application-level Blazor -> Razor/Blazor change channel.
        // JS is an independent, optional last-mile bridge for an already-rendered Razor DOM.
        if (Volatile.Read(ref _jsBridgeEnabled) && !string.IsNullOrWhiteSpace(JsMessageHandler))
            await JS.InvokeVoidAsync(JsMessageHandler, _actorId, XCounter);
    }

    private void OnDataChanged(object? sender, RazorBlazorDataChangedEventArgs e)
    {
        if (!DataExchange.ShouldProcessChange(
                RazorBlazorDataExchangeSessionId,
                _actorId,
                e))
        {
            return;
        }

        if (e.PropertyName == JsBridgeProperty && e.Value is bool enabled)
        {
            Volatile.Write(ref _jsBridgeEnabled, EnableJsDomBridge && enabled);
            return;
        }

        if (e.PropertyName != CounterProperty || e.Value is not int value)
            return;

        _ = InvokeAsync(() =>
        {
            _currentCount = value;
            XCounter = _currentCount;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        if (!_changeEventSubscribed)
            return;

        DataExchange.DataChanged -= OnDataChanged;
        _changeEventSubscribed = false;
    }
}
